// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
namespace public {
  model Menu {
    id          String         @id(map: "menu_pkey")
    nombre      String
    categoria   String
    precio      Numeric(10, 2)
    descripcion String?
    foto        String?
    alt         String?
    createdAt   Timestamptz    @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

    @@rls
    @@map("menu")
  }

  policy_select Lectura_pública_del_menú {
    target = Menu
    roles =[anon, authenticated]
    using = "true"

    @@map("Lectura pública del menú")
  }
}
